<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere; only system CAs (no user-installed MITM certificates). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
